# Servicio del chatbot. Copiá este archivo como .env y completá los valores.
# El .env NO se sube a Git (está en .gitignore).

# ── IA (obligatorio) ─────────────────────────────────────────────────
# Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# El default está medido: el lite responde en 1-2 s. Los Flash grandes tardan
# 17-35 s o devuelven 503, que para un chat no sirve.
# GEMINI_MODEL=gemini-3.1-flash-lite

# ── Servicio ─────────────────────────────────────────────────────────
# CATALOG_API_URL=http://127.0.0.1:8787
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=8790
# MAX_HISTORIAL=10

# ── Base de datos (opcional: sin esto guarda el historial en memoria) ─
# DATABASE_URL=postgresql://jaka_bot:TU_CLAVE@127.0.0.1:5432/jaka_chatbot

# ── WhatsApp Cloud API ───────────────────────────────────────────────
# Sin estas cuatro el chat local funciona igual, pero el webhook responde 503.
# Se sacan de la app de Meta: developers.facebook.com → tu app → WhatsApp → API Setup.
# Un número nuevo (o liberado de la app) es suficiente para probar.
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# El verify token lo inventás vos; tiene que coincidir con el que pegues en Meta.
# META_VERIFY_TOKEN=jaka-bici-2026
# META_API_VERSION=v25.0
